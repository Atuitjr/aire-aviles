# Copia este fichero como .env (nunca subas el .env a GitHub).

# Base de datos: fichero local en desarrollo. En producción (Turso) estas dos variables
# van en GitHub Secrets y en Cloudflare, no aquí. Ver DEPLOY.md.
DATABASE_URL=file:./data/aviles.db
DATABASE_AUTH_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
# Secreto del webhook (el mismo que guardas en Cloudflare). Solo lo usa `npm run set-webhook`.
WEBHOOK_SECRET=

# API
API_PORT=3001

# Worker local: expresión cron de la ingesta (por defecto, cada hora en el minuto 5)
INGEST_CRON=5 * * * *

# Web: API de datos (por defecto, la del Worker de producción)
# PUBLIC_AIRE_API_URL=https://aire-aviles-bot.<tu-subdominio>.workers.dev
