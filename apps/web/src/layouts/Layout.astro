---
import "../styles/global.css";
import { BOT_URL, SITE_NAME, SITE_DESCRIPTION } from "../config.ts";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: calidad del aire en Avilés y Asturias`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#edf1f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1a1d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="saltar visualmente-oculto" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera-fila">
        <a class="marca" href="/" aria-label={`${SITE_NAME}, inicio`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
            <rect x="1" y="15" width="3.6" height="8" rx="1" fill="var(--nivel-0)"></rect>
            <rect x="5.7" y="12" width="3.6" height="11" rx="1" fill="var(--nivel-1)"></rect>
            <rect x="10.4" y="9" width="3.6" height="14" rx="1" fill="var(--nivel-2)"></rect>
            <rect x="15.1" y="5" width="3.6" height="18" rx="1" fill="var(--nivel-3)"></rect>
            <rect x="19.8" y="1" width="3.2" height="22" rx="1" fill="var(--nivel-4)"></rect>
          </svg>
          {SITE_NAME}
        </a>
        <nav aria-label="Principal">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Ahora</a>
          <a href="/que-significa/" aria-current={path.startsWith("/que-significa") ? "page" : undefined}>Qué significa</a>
          <a class="avisos" href={BOT_URL} rel="noopener">Avisos en Telegram</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p>
          Datos de la Red de Control de la Calidad del Aire del Principado de Asturias, publicados casi en tiempo real
          por la Agencia Europea de Medio Ambiente. Son provisionales y llegan con unas horas de retraso. El histórico
          anterior a este año usa los datos ya verificados.
        </p>
        <p>
          {SITE_NAME} es un proyecto independiente, no un servicio oficial. Ante un episodio de contaminación, sigue las
          indicaciones de las autoridades sanitarias.
        </p>
      </div>
    </footer>

    <style>
      .saltar:focus {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        width: auto;
        height: auto;
        clip: auto;
        padding: 0.5rem 0.75rem;
        background: var(--superficie);
        z-index: 10;
      }
      .cabecera {
        border-bottom: 1px solid var(--linea);
      }
      .cabecera-fila {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-block: 0.9rem;
      }
      .marca {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        font-size: var(--t1);
        text-decoration: none;
      }
      nav {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        align-items: center;
        font-weight: 600;
      }
      nav a {
        text-decoration: none;
        color: var(--tinta-2);
      }
      nav a:hover,
      nav a[aria-current="page"] {
        color: var(--tinta);
        text-decoration: underline;
      }
      nav .avisos {
        color: var(--tinta);
        border: 1px solid var(--tinta);
        border-radius: 999px;
        padding: 0.25rem 0.8rem;
      }
      nav .avisos:hover {
        background: var(--tinta);
        color: var(--niebla);
        text-decoration: none;
      }
      main {
        padding-block: 2.5rem 4rem;
      }
      .pie {
        border-top: 1px solid var(--linea);
        padding-block: 2rem 3rem;
        color: var(--tinta-3);
        font-size: var(--t-1);
      }
      .pie p + p {
        margin-top: 0.75rem;
      }
    </style>
  </body>
</html>
