---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        font-family: system-ui, sans-serif;
        color-scheme: light dark;
      }
      body {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
